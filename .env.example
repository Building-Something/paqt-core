GROQ_API_KEY=
PORT=3001

# Supabase (create a project, then copy these from Project Settings > API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side Supabase credentials — REQUIRED to enforce usage plans.
# Without them the /api/groq proxy skips auth + metering (local dev only).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ---------------------------------------------------------------------------
# Billing provider selection
# ---------------------------------------------------------------------------
# Which provider the BROWSER talks to. Baked into the bundle at build time, so it
# is a separate variable from the Edge Function `BILLING_PROVIDER` above and the
# two must agree — if they disagree the checkout endpoint refuses the call rather
# than charging through the wrong provider.
# VITE_BILLING_PROVIDER=polar

# Which provider new purchases go through. `razorpay` (the default) keeps the
# existing flow; `polar` switches checkout, webhooks and subscription management
# to Polar. Both remain deployed during a migration — flipping this back is the
# rollback.
#
# NOTE: this file is only read by the Edge Functions. To change it in production
# set it as a function secret rather than editing this file, e.g.
#   supabase secrets set BILLING_PROVIDER=polar
BILLING_PROVIDER=razorpay

# ---------------------------------------------------------------------------
# Polar (polar.sh → Settings → API, then create a webhook endpoint)
# ---------------------------------------------------------------------------
# Only needed when BILLING_PROVIDER=polar. Keep Razorpay's values above while
# migrating: they are the rollback path, and leaving them costs nothing.
#
# 1. Organization → Settings → API → create an organization access token.
#    REVOKE any token pasted into a chat or committed anywhere — treat it as
#    public. Store the new one here only; .env is gitignored.
POLAR_ACCESS_TOKEN=polar_oat_...

# 2. Create products in the Polar dashboard for Individual ($39) and Pro ($59),
#    then record the PRODUCT ids below. Polar checkout addresses products, not
#    prices, so a price id will be rejected.
#
#    Product ids are bare UUIDs with no `prod_` prefix. Take them from the
#    dashboard URL for each product, or from `GET /v1/products/`.
#
#    These two lines are scratch space only — no code reads them. Checkout looks
#    the product up in the `plan_prices` table, so the ids are not live until
#    they are inserted as below, AFTER running supabase/migrations/*.sql.
#
#    Prices are in US dollars, so amounts are in cents. Paqt displays these as
#    $39 and $59; the minor-unit conversion belongs to the provider API.
#      insert into public.plan_prices
#        (plan_id, provider, provider_product_id, currency, unit_amount, billing_interval)
#      values
#        ('individual', 'polar', '<uuid>', 'usd', 3900, 'month'),
#        ('pro',        'polar', '<uuid>', 'usd', 5900, 'month');
POLAR_INDIVIDUAL_PRODUCT_ID=
POLAR_PRO_PRODUCT_ID=

# 3. Webhook endpoint → Name `polar-webhook`, Format `Raw`, API version `2026-10`
#    URL https://YOUR-PROJECT-REF.supabase.co/functions/v1/polar-webhook
#    Events: the `subscription.*` lifecycle events plus order.paid, order.refunded.
#    Paste the signing secret it shows below. It starts `whsec_`; the handler
#    accepts either key derivation, so it works before or after Polar's
#    8 Sep 2026 cutover to the Standard Webhooks scheme.
POLAR_WEBHOOK_SECRET=whsec_...

# Which Polar environment to talk to. `sandbox` and `production` are fully
# isolated, so a sandbox token pointed at production would charge real cards.
# Leave this blank to use the documented default (sandbox).
POLAR_ENVIRONMENT=sandbox
# POLAR_API_BASE_URL=

# Deploy the Polar functions (Razorpay's stay in place for rollback):
#   supabase functions deploy create-polar-checkout polar-webhook subscription-manage

# ---------------------------------------------------------------------------
# Razorpay (dashboard.razorpay.com → Settings → API Keys when in test mode)
# ---------------------------------------------------------------------------
# 1. Create plan IDs via the Razorpay API/dashboard for Individual (₹2,999) and
#    Pro (₹5,999). Amounts are in paise — 299900 and 599900 — currency INR.
# 2. Run supabase/migrations/*.sql, then paste the plan IDs into the SQL editor:
#    update public.plans set price_id = '<plan_...>' where id = 'individual';
#    update public.plans set price_id = '<plan_...>' where id = 'pro';
# 3. Deploy the edge functions:
#    supabase functions deploy create-checkout-session subscription-manage razorpay-webhook
# 4. Add a webhook at dashboard.razorpay.com → Settings → Webhooks:
#    https://YOUR-PROJECT-REF.supabase.co/functions/v1/razorpay-webhook
#    with events subscription.activated, subscription.charged, subscription.resumed,
#    subscription.updated, subscription.pending, subscription.completed,
#    subscription.cancelled, subscription.paused, subscription.halted,
#    payment.authorized, payment.captured, payment.failed, payment.refunded,
#    refund.processed — then paste its secret below (must match the webhook secret).
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# Browser origins allowed to call the billing Edge Functions (comma separated,
# exact match). Localhost on any port is always allowed so `npm run dev` works.
# Set this to your production origin(s) to pin CORS to a custom domain, e.g.
# APP_ORIGIN_ALLOW_LIST=https://paqt.app,https://www.paqt.app
# APP_ORIGIN_ALLOW_LIST=

# Public URL used for the in-app success redirect after checkout (defaults to localhost:3001)
APP_URL=https://YOUR-PROJECT-REF.vercel.app