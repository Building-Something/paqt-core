GROQ_API_KEY=
PORT=3001

# Supabase (create a project, then copy these from Project Settings > API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side Supabase credentials — REQUIRED to enforce usage plans.
# Without them the /api/groq proxy skips auth + metering (local dev only).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Razorpay (dashboard.razorpay.com → Settings → API Keys when in test mode)
# 1. Create plan IDs via the Razorpay API/dashboard for Individual (₹2,999) and
#    Pro (₹5,999). Amounts are in paise — 299900 and 599900 — currency INR.
# 2. Paste the plan IDs into the SQL editor (or supabase/billing.sql):
#    update public.plans set price_id = '<plan_...>' where id = 'individual';
#    update public.plans set price_id = '<plan_...>' where id = 'pro';
# 3. Deploy the edge functions:
#    supabase functions deploy create-checkout-session subscription-manage razorpay-webhook
# 4. Add a webhook at dashboard.razorpay.com → Settings → Webhooks:
#    https://YOUR-PROJECT-REF.supabase.co/functions/v1/razorpay-webhook
#    with events subscription.activated, subscription.charged, subscription.completed,
#    subscription.cancelled, subscription.paused, payment.failed —
#    then paste its secret below (must match the secret set on the webhook).
RAZORPAY_KEY_ID=rzp_test_TexDXV4N4oUqEl
RAZORPAY_KEY_SECRET=kFKpqvnirai6tjxsFGFPqJvD
RAZORPAY_WEBHOOK_SECRET=...

# Public URL used for the in-app success redirect after checkout (defaults to localhost:3001)
APP_URL=https://YOUR-PROJECT-REF.vercel.app