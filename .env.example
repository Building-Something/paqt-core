GROQ_API_KEY=
PORT=3001

# Supabase (create a project, then copy these from Project Settings > API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Optional: plan/billing enforcement on /api/groq (Node server) ---
# When both are set, the server validates the caller's Supabase access token
# and requires an ACTIVE subscription row before proxying AI calls (402
# plan_required otherwise). Leave unset to skip enforcement in local dev.
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_service_role_...

# --- Optional: Razorpay subscriptions (edge functions) ---
# Used by supabase/functions/create-checkout-session and subscription-manage.
# Set them on Supabase instead with: supabase secrets set RAZORPAY_KEY_ID=...
# (for local `supabase functions serve`, put them here).
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...

# Point the Razorpay dashboard webhook at
# https://YOUR-PROJECT-REF.supabase.co/functions/v1/razorpay-webhook and
# subscribe to: subscription.activated, subscription.charged,
# subscription.resumed, subscription.updated, subscription.pending,
# subscription.completed, subscription.cancelled, subscription.paused,
# subscription.halted, payment.authorized, payment.captured, payment.failed,
# payment.refunded, refund.processed.